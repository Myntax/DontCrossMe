# ---------------------------------------------------------------------------
# DontCrossMe configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# Database. Default is SQLite (great for personal / forked instances).
# For a society at scale, switch prisma/schema.prisma's `provider` to
# "postgresql" and point this at your Postgres instance.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# The single coordinator/admin login for v1 (Phase 2 adds full accounts).
# The password is hashed on first boot via the seed script.
ADMIN_EMAIL="coordinator@example.org"
ADMIN_PASSWORD="change-me"

# --- Optional AI layer (OFF by default) -----------------------------------
# The entire app is fully functional with AI disabled. Leave AI_ENABLED unset
# or "false" and no data is ever sent to any model. Turn it on ONLY if you and
# your members are comfortable with it; even then, the licensing gate ensures
# only sources you have marked `aiUseAllowed` can reach the model.
AI_ENABLED="false"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# --- Branding (forkable) ---------------------------------------------------
SOCIETY_NAME="My Orchid Society"
